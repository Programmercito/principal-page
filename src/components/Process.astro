---
import { Icon } from 'astro-icon/components';

const steps = [
  {
    icon: 'mdi:chat-processing-outline',
    title: 'Consulta gratis',
    desc: 'Contanos tu idea o problema. Escuchamos, analizamos y te orientamos sin costo ni compromiso.',
    tag: 'Día 1',
  },
  {
    icon: 'mdi:file-document-edit-outline',
    title: 'Propuesta clara',
    desc: 'Alcance, plazo y presupuesto por escrito. Sin letra chica, sin sorpresas de precio.',
    tag: '2-3 días',
  },
  {
    icon: 'mdi:rocket-launch-outline',
    title: 'Desarrollo por etapas',
    desc: 'Entregas parciales que probás sobre la marcha. Siempre sabés en qué punto está tu proyecto.',
    tag: 'Core',
  },
  {
    icon: 'mdi:shield-check-outline',
    title: 'Entrega + soporte',
    desc: 'Lanzamiento con documentación, soporte post-entrega y planes de mantenimiento opcionales.',
    tag: 'Post',
  },
];
---

<section id="proceso" class="py-28 relative overflow-hidden">
  <div class="process-bg"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="text-center mb-16 fade-in-element">
      <span class="process-label">Metodología</span>
      <h2 class="section-title">Cómo Trabajamos</h2>
      <p class="section-subtitle">
        Un proceso simple y transparente, pensado para que vos te dediques a tu negocio mientras nosotros nos ocupamos de la tecnología.
      </p>
    </div>

    <div class="process-steps">
      <div class="steps-line" aria-hidden="true"></div>
      {steps.map((step, i) => (
        <div class="step-card fade-in-element" style={`transition-delay:${i * 0.1}s`}>
          <div class="step-top">
            <div class="step-number">0{i + 1}</div>
            <div class="step-icon">
              <Icon name={step.icon} class="step-icon-svg" />
            </div>
          </div>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.desc}</p>
          <span class="step-tag">{step.tag}</span>
          <div class="step-glow" aria-hidden="true"></div>
        </div>
      ))}
    </div>

    <div class="text-center mt-14 fade-in-element">
      <a href="#contact" class="process-cta">
        Empezar con una consulta gratuita
        <svg xmlns="http://www.w3.org/2000/svg" class="process-cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .process-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 70% at 50% 0%, var(--gradient-glow-top) 0%, transparent),
      radial-gradient(ellipse 40% 50% at 90% 90%, var(--gradient-glow-right) 0%, transparent);
    pointer-events: none;
    transition: var(--theme-transition);
  }

  .process-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-cyan);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 4px 16px;
    margin-bottom: 1rem;
    transition: var(--theme-transition);
  }

  .process-steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Connecting line behind the cards (desktop) */
  .steps-line {
    position: absolute;
    top: 46px;
    left: 10%;
    right: 10%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-cyan), var(--color-blue), var(--color-cyan), transparent);
    opacity: 0.35;
    pointer-events: none;
  }

  .step-card {
    position: relative;
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 20px;
    padding: 1.75rem 1.5rem;
    backdrop-filter: blur(16px);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03);
    overflow: hidden;
  }

  .step-card:hover {
    transform: translateY(-8px);
    border-color: var(--color-cyan);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12), 0 0 25px var(--color-accent-glow);
  }

  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .step-number {
    font-family: 'Outfit', sans-serif;
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(135deg, var(--color-cyan), var(--color-blue));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    opacity: 0.9;
  }

  .step-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-soft);
    border: 1px solid var(--color-border);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.3s ease, background 0.3s ease;
  }
  .step-card:hover .step-icon {
    transform: scale(1.12) rotate(-6deg);
    border-color: var(--color-cyan);
    background: var(--color-accent-glow);
  }

  .step-icon-svg {
    width: 26px;
    height: 26px;
    color: var(--color-cyan);
  }

  .step-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
    transition: color 0.3s ease;
  }
  .step-card:hover .step-title { color: var(--color-cyan); }

  .step-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    flex: 1;
  }

  .step-tag {
    align-self: flex-start;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-cyan);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 3px 12px;
    transition: var(--theme-transition);
  }

  .step-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 50% at 50% 0%, var(--color-accent-glow), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .step-card:hover .step-glow { opacity: 1; }

  /* CTA */
  .process-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: white;
    text-decoration: none;
    padding: 0.85rem 2rem;
    border-radius: 50px;
    background: linear-gradient(135deg, var(--color-cyan) 0%, var(--color-blue) 55%, var(--color-purple) 100%);
    box-shadow: 0 4px 20px var(--color-accent-shadow), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .process-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 35px var(--color-accent-shadow);
  }

  .process-cta-icon { width: 17px; height: 17px; flex-shrink: 0; }

  /* Responsive */
  @media (max-width: 1024px) {
    .process-steps { grid-template-columns: repeat(2, 1fr); }
    .steps-line { display: none; }
  }

  @media (max-width: 640px) {
    .process-steps { grid-template-columns: 1fr; max-width: 420px; }
    .step-number { font-size: 2rem; }
  }
</style>
