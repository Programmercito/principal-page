---
// Infinite marquee of core services — visual trust strip.
const services = [
  'Desarrollo Web a Medida',
  'Sistemas ERP',
  'Automatización de Procesos',
  'Consultoría TI',
  'Marketing Digital',
  'SEO',
  'Landing Pages',
  'Aplicaciones Web',
];
---

<div class="trust-marquee" aria-hidden="true">
  <div class="marquee-edges"></div>

  <div class="marquee-row">
    <div class="marquee-track">
      {services.concat(services).map((s) => (
        <span class="marquee-item"><span class="marquee-sep">✦</span>{s}</span>
      ))}
    </div>
  </div>
</div>

<style>
  .trust-marquee {
    position: relative;
    padding: 1.4rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    overflow: hidden;
    transition: var(--theme-transition);
  }

  .marquee-edges {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background:
      linear-gradient(90deg, var(--color-bg-secondary) 0%, transparent 12%, transparent 88%, var(--color-bg-secondary) 100%);
    transition: var(--theme-transition);
  }

  .marquee-row { overflow: hidden; }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: 2.2rem;
    width: max-content;
    animation: marquee-scroll 40s linear infinite;
  }

  .trust-marquee:hover .marquee-track { animation-play-state: paused; }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text-secondary);
  }

  .marquee-sep {
    color: var(--color-cyan);
    opacity: 0.6;
    font-size: 0.7em;
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 640px) {
    .marquee-track { gap: 1.4rem; }
    .marquee-item { font-size: 0.72rem; }
  }
</style>
