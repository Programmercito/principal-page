---
import { faqs } from '../data/faq';
---

<section id="faq" class="py-28 relative overflow-hidden">
  <div class="faq-bg"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="text-center mb-16 fade-in-element">
      <span class="faq-label">FAQ</span>
      <h2 class="section-title">Preguntas Frecuentes</h2>
      <p class="section-subtitle">Todo lo que necesitás saber antes de empezar.</p>
    </div>

    <div class="faq-list fade-in-element">
      {faqs.map((item) => (
        <details class="faq-item">
          <summary class="faq-question">
            <span class="faq-q-text">{item.q}</span>
            <span class="faq-chevron" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </span>
          </summary>
          <div class="faq-answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 55% 70% at 50% 100%, var(--gradient-glow-left) 0%, transparent),
      radial-gradient(ellipse 40% 50% at 80% 10%, var(--gradient-glow-right) 0%, transparent);
    pointer-events: none;
    transition: var(--theme-transition);
  }

  .faq-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-cyan);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 5px 18px;
    margin-bottom: 1.25rem;
    box-shadow: 0 0 15px var(--color-accent-glow);
    transition: var(--theme-transition);
  }

  .section-subtitle {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.7;
    transition: var(--theme-transition);
  }

  .faq-list {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 16px;
    backdrop-filter: blur(16px);
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
  }

  .faq-item[open] {
    border-color: var(--color-cyan);
    box-shadow: 0 0 24px var(--color-accent-glow);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    list-style: none;
    color: var(--color-text-primary);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    transition: color 0.25s ease;
    user-select: none;
  }

  .faq-question::-webkit-details-marker { display: none; }
  .faq-question::marker { display: none; }

  .faq-item[open] .faq-question { color: var(--color-cyan); }

  .faq-q-text { flex: 1; }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.25s ease;
    display: flex;
    align-items: center;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--color-cyan);
  }

  .faq-answer {
    padding: 0 1.5rem 1.25rem;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.75;
    transition: var(--theme-transition);
  }
</style>
